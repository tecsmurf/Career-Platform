# Copy to backend/.env for local development. Never commit real values.

# "development" locally; set ENVIRONMENT=production on Render (enables safety checks)
ENVIRONMENT=development
DEBUG=false

# Generate: openssl rand -hex 32   (REQUIRED in production)
SECRET_KEY=

# Local Postgres (docker-compose) — or use SQLite for a zero-setup local run:
#   DATABASE_URL=sqlite+aiosqlite:///./local.db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/career_platform

# Exact frontend origins, comma-separated (recommended in production)
ALLOWED_ORIGINS=http://localhost:5173

# Encrypts stored mailbox credentials. Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Comma-separate keys to rotate (first encrypts, all decrypt). If empty, derived from SECRET_KEY.
EMAIL_ENCRYPTION_KEY=

# Optional: enables AI extraction on top of rule-based detection
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Login rate limiting (token buckets; defaults shown)
# Per account: burst of 50 attempts, then +1 attempt every 1.2 s.
# LOGIN_BUCKET_CAPACITY=50
# LOGIN_BUCKET_REFILL_SECONDS=1.2
# Per client IP (defence in depth): burst 100, +1 every 3 s.
# LOGIN_IP_BUCKET_CAPACITY=100
# LOGIN_IP_BUCKET_REFILL_SECONDS=3.0
# Header your edge proxy overwrites with the real client IP. On Render (behind
# Cloudflare) use CF-Connecting-IP. In production the IP bucket stays off until
# this is set (otherwise every user would share the proxy's address).
# CLIENT_IP_HEADER=CF-Connecting-IP
# "memory" is correct for one process. Use "redis" when running several
# workers/instances; if Redis is unreachable it falls back to in-process buckets.
# RATE_LIMIT_BACKEND=memory
# REDIS_URL=redis://localhost:6379/0

# Optional sync tuning (defaults shown)
# EMAIL_SYNC_DEFAULT_DAYS=30
# EMAIL_SYNC_MAX_MESSAGES=100
# EMAIL_SYNC_COOLDOWN_SECONDS=60
# EMAIL_SYNC_TIME_BUDGET_SECONDS=45
