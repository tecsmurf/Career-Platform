# Copy to backend/.env for local development. Never commit real values.

# "development" locally; set ENVIRONMENT=production on Render (enables safety checks)
ENVIRONMENT=development
DEBUG=false

# Generate: openssl rand -hex 32   (REQUIRED in production)
SECRET_KEY=

# Local Postgres (docker-compose) — or use SQLite for a zero-setup local run:
#   DATABASE_URL=sqlite+aiosqlite:///./local.db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/career_platform

# Exact frontend origins, comma-separated (recommended in production)
ALLOWED_ORIGINS=http://localhost:5173

# Encrypts stored mailbox credentials. Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Comma-separate keys to rotate (first encrypts, all decrypt). If empty, derived from SECRET_KEY.
EMAIL_ENCRYPTION_KEY=

# Optional: enables AI extraction on top of rule-based detection
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional sync tuning (defaults shown)
# EMAIL_SYNC_DEFAULT_DAYS=30
# EMAIL_SYNC_MAX_MESSAGES=100
# EMAIL_SYNC_COOLDOWN_SECONDS=60
# EMAIL_SYNC_TIME_BUDGET_SECONDS=45
